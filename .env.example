# Copy to .env (gitignored). quackd loads it automatically via python-dotenv.
# You only need the key for the provider you pass to `--provider`.
# `--provider fake` needs no key at all.

# One per vendor, and nothing after the `=`: python-dotenv reads the rest of the line as the
# value, so a trailing comment here would become the key itself. `quackd list-models` names
# the vendors, and `quackd doctor` says which of these it can see.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Cohere, whose own examples export CO_API_KEY instead. quackd reads that if this is empty.
COHERE_API_KEY=
# Qwen, on Alibaba Model Studio.
DASHSCOPE_API_KEY=
# Kimi, on Moonshot.
MOONSHOT_API_KEY=
# GLM, on Z.ai.
ZAI_API_KEY=
# Meta Model API (Muse Spark). Meta's own examples export MODEL_API_KEY, read if this is empty.
META_API_KEY=

# OpenAI only. Some reasoning models refuse function tools on chat/completions; quackd
# reads that 400 and switches the run to the Responses API on its own. Start there instead:
# QUACKD_OPENAI_API=responses
# QUACKD_OPENAI_REASONING_EFFORT=low   # low, medium, high or xhigh, on either API

# Local and open-source models (see docs/local-llms.md). Presets ollama, vllm, llamacpp and
# lmstudio have default addresses; `--provider local` needs QUACKD_BASE_URL or --base-url.
# QUACKD_BASE_URL=http://localhost:8000/v1
# LOCAL_API_KEY=not-needed
# QUACKD_TOOL_CHOICE=auto        # auto (default) | required | none (omit the field)
# QUACKD_VISION=0                # 1 to send camera frames to a local vision model

# Optional: override the model for the chosen provider. A cloud provider takes an id from
# quackd's catalogue and refuses anything else before it calls out, so `quackd list-models`
# (or `quackd list-models --provider openai`) is the list to pick from. A local provider takes
# any id its own server serves. Left unset, each provider uses its own default.
# QUACKD_MODEL=claude-opus-5
# Anthropic only: reasoning effort (low|medium|high|xhigh|max), default medium.
# QUACKD_EFFORT=medium
# Anthropic only: set to 0 to disable server-side refusal fallbacks.
# QUACKD_ANTHROPIC_FALLBACKS=1

# What quackd shows while it runs: the prompt, what the model thought, every executor
# decision, every intent sent to the robot, every result. On by default (docs/architecture.md).
# QUACKD_TRACE=1                 # 0 to turn it off, in the CLI and the MCP server alike
# QUACKD_TRACE_THINKING=2000     # characters of reasoning the terminal shows per turn; `all`, or 0 for none
# QUACKD_TRACE_PROMPT=1          # 0 hides the system prompt; the transcript keeps it either way
# Anthropic only: `omitted` stops the model returning a summary of its reasoning.
# QUACKD_THINKING_DISPLAY=summarized
# Gemini only: 0 stops quackd asking for thought summaries.
# QUACKD_GEMINI_THOUGHTS=1

# The physics simulator (`--robot microduck:mujoco`, needs quackd[mujoco]). The first run
# fetches upstream's model and policies into ~/.quackd/cache and checks every file's sha256.
# QUACKD_MUJOCO_BODY=puppet      # a kinematic stand-in that downloads nothing
# QUACKD_CACHE_DIR=~/.quackd/cache
# QUACKD_MICRODUCK_ASSETS=       # a microduck_rl checkout of your own, instead of the download
# QUACKD_MUJOCO_SHADOWS=0        # 1 for upstream's shadows: the prettiest render and the slowest

# The robots you have named and the flocks you made of them (`quackd robot`,
# `quackd flock`, docs/registry.md). Two files in this directory: robots.json holds the
# address and token of each robot, flocks.json the groups. `--registry-dir` beats this.
# QUACKD_REGISTRY_DIR=~/.quackd

# What each robot remembers between runs (`quackd memory`, docs/memory.md).
# QUACKD_MEMORY_DIR=~/.quackd/memory
