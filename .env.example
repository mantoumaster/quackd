# Copy to .env (gitignored). quackd loads it automatically via python-dotenv, from two places:
# the folder you run the command in, and then, walking up from where quackd itself is installed,
# which is why a .env in the root of a `uv venv` (beside pyvenv.cfg) is read wherever you run
# from. Neither file overrides a variable that is already set in your environment, and when both
# name the same variable the first to define it wins, so the file next to the command you typed
# is the one that counts.
# Copy the names below exactly. They are case sensitive on macOS and Linux, where OPENAI_API_Key
# is not OPENAI_API_KEY, and Windows takes either, so a file that works on one laptop can fail on
# the next.
# You only need the key for the provider you pass to `--provider`.
# `--provider fake` needs no key at all.

# One per vendor, and nothing after the `=`: python-dotenv reads the rest of the line as the
# value, so a trailing comment here would become the key itself. `quackd list-models` names
# the vendors, and `quackd doctor` says which of these it can see.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Cohere, whose own examples export CO_API_KEY instead. quackd reads that if this is empty.
COHERE_API_KEY=
# Qwen, on Alibaba Model Studio.
DASHSCOPE_API_KEY=
# Kimi, on Moonshot.
MOONSHOT_API_KEY=
# GLM, on Z.ai.
ZAI_API_KEY=
# Meta Model API (Muse Spark). Meta's own examples export MODEL_API_KEY, read if this is empty.
META_API_KEY=

# OpenAI only. Some reasoning models refuse function tools on chat/completions; quackd
# reads that 400 and switches the run to the Responses API on its own. Start there instead:
# QUACKD_OPENAI_API=responses
# QUACKD_OPENAI_REASONING_EFFORT=low   # low, medium, high or xhigh, on either API

# Local and open-source models (see docs/local-llms.md). Presets ollama, vllm, llamacpp and
# lmstudio have default addresses; `--provider local` needs QUACKD_BASE_URL or --base-url.
# QUACKD_BASE_URL=http://localhost:8000/v1
# LOCAL_API_KEY=not-needed
# QUACKD_TOOL_CHOICE=auto        # auto (default) | required | none (omit the field)
# QUACKD_VISION=0                # 1 to send camera frames to a local vision model
# A JSON object merged into every request body, for a field the server wants and quackd
# never sends: this one turns Qwen3's thinking off on vLLM. Every provider that speaks
# OpenAI's API reads it, and --extra-body beats it. Single quotes or none, never double
# quotes, which python-dotenv drops without setting anything.
# QUACKD_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# Optional: override the model for the chosen provider. A cloud provider takes an id from
# quackd's catalogue and refuses anything else before it calls out, so `quackd list-models`
# (or `quackd list-models --provider openai`) is the list to pick from. A local provider takes
# any id its own server serves. Left unset, each provider uses its own default.
# QUACKD_MODEL=claude-opus-5
# Anthropic only: reasoning effort (low|medium|high|xhigh|max), default medium.
# QUACKD_EFFORT=medium
# Anthropic only: set to 0 to disable server-side refusal fallbacks.
# QUACKD_ANTHROPIC_FALLBACKS=1

# The log: what quackd shows while it runs, which is the prompt, what the model thought, every
# executor decision, every intent sent to the robot, every result. On by default. On a run
# these say what you watch and not what is kept, because the run directory gets its transcript
# either way (docs/architecture.md). Nothing after the `=` on a line you uncomment: python-dotenv
# would read the trailing comment below as part of the value.
# QUACKD_LOG=1                   # 0 to turn it off, in the CLI and the MCP server alike
# QUACKD_LOG_THINKING=2000       # characters of reasoning the terminal shows per turn; `all`, or 0 for none
# QUACKD_LOG_PROMPT=1            # 0 hides the system prompt; the transcript keeps it either way
# The QUACKD_TRACE* names still work and go in 0.12. Each says once what it is now called, but
# only on a run that reads it, so grep your own .env files and CI for QUACKD_TRACE rather than
# waiting to be told about all three.
# Anthropic only: `omitted` stops the model returning a summary of its reasoning.
# QUACKD_MAX_TOKENS=16000        # the answer budget per turn
# QUACKD_THINKING_DISPLAY=summarized
# Gemini only: 0 stops quackd asking for thought summaries.
# QUACKD_GEMINI_THOUGHTS=1
# What the model costs, in USD per million tokens: the cost counter a run prints and the
# `cost_usd` it writes into its summary and beside every model call. `in` and `out` are
# required, `cache_read` and `cache_write` optional, comma separated. `--price` beats this and
# both beat quackd's own catalogue rate. Set it for a rate you negotiated, a model quackd has
# no published rate for, or a paid server behind a local preset. Nothing after the `=` here
# either: python-dotenv would read the trailing comment as part of the rate.
# QUACKD_PRICE=in=3,out=15,cache_read=0.3,cache_write=3.75

# The physics simulator (`--robot microduck:mujoco`, needs quackd[mujoco]). The first run
# fetches upstream's model and policies into ~/.quackd/cache and checks every file's sha256.
# QUACKD_MUJOCO_BODY=puppet      # a kinematic stand-in that downloads nothing
# QUACKD_CACHE_DIR=~/.quackd/cache
# QUACKD_MICRODUCK_ASSETS=       # a microduck_rl checkout of your own, instead of the download
# QUACKD_MUJOCO_SHADOWS=0        # 1 for upstream's shadows: the prettiest render and the slowest

# The LeRobot arm (`--robot lerobot:real`): how far one action may move a joint, in degrees.
# It is re-sent ten times a second, so this is also the top joint speed. Lower it first.
# QUACKD_LEROBOT_MAX_STEP_DEG=5
# The pose the arm is driven to before torque is ever released has no variable here: you fold
# the arm by hand and record it with `quackd robot rest-pose <name>`, and it is kept in the
# registry beside that robot's address (docs/safety.md).

# The robots you have named and the flocks you made of them (`quackd robot`,
# `quackd flock`, docs/registry.md). Two files in this directory: robots.json holds each
# robot's address, token, camera or cameras and rest pose, flocks.json the groups.
# `--registry-dir` beats this.
# QUACKD_REGISTRY_DIR=~/.quackd

# The bridge token a robot that wants one is reached with, when `--token` is absent and the
# robot is not one you registered. Each robot's own installer or daemon writes it on the robot.
# QUACKD_DUCK_TOKEN=            # the Open Duck Mini v2 (bridge/open_duck/install.sh writes it)
# QUACKD_TODDLERBOT_TOKEN=      # the ToddlerBot (its daemon has no installer, so you choose it)

# TypeSafe's Jev, the optional discrete stepper in front of the model (`quackd run --jev on`,
# docs/jev.md). Nothing here is read unless a run asks for it: `--jev off` is the default, and
# a key sitting here never switches it on by itself. Needs quackd[jev].
TYPESAFE_API_KEY=
# QUACKD_JEV=off                      # off (default) | shadow | on; --jev beats this
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0   # jev-latest and jev-preview are the moving aliases
# TYPESAFE_BASE_URL=                  # where the API is, if not TypeSafe's own
# What a stepper question costs, quackd's own variable rather than one the SDK reads, and the
# same syntax as QUACKD_PRICE above. The default is TypeSafe's published rate, $0.042 per
# million input tokens with output not charged, so this is only for a model priced differently.
# Nothing after the `=` here either, for the same reason.
# QUACKD_JEV_PRICE=in=0.042,out=0

# What each robot remembers between runs (`quackd memory`, docs/memory.md).
# QUACKD_MEMORY_DIR=~/.quackd/memory
