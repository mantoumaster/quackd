{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rokbenko/quackd/blob/main/quackd/adapters/manifest.schema.json",
  "$defs": {
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "default": "body",
          "enum": [
            "body",
            "head",
            "base",
            "world"
          ],
          "title": "Reference",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "Frame",
      "type": "object"
    },
    "SafetyAuthority": {
      "additionalProperties": false,
      "description": "Who stops the body when quackd goes quiet. Honesty matters more than the enum.",
      "properties": {
        "native": {
          "default": "none",
          "enum": [
            "robotd_deadman",
            "lease",
            "torque_limit",
            "estop",
            "none"
          ],
          "title": "Native",
          "type": "string"
        },
        "deadman": {
          "default": false,
          "description": "The robot zeroes motion on silence.",
          "title": "Deadman",
          "type": "boolean"
        },
        "heartbeat_hz": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 50,
          "title": "Heartbeat Hz",
          "type": "number"
        }
      },
      "title": "SafetyAuthority",
      "type": "object"
    },
    "VerbSpec": {
      "additionalProperties": false,
      "description": "One verb a robot provides. `name` is canonical (never an alias).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "core": {
          "default": false,
          "description": "A core verb: the same on every robot.",
          "title": "Core",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "description": "LLM-facing text. Empty means the implementation's default.",
          "title": "Description",
          "type": "string"
        },
        "params_schema": {
          "additionalProperties": true,
          "description": "JSON schema of the parameters (informational).",
          "title": "Params Schema",
          "type": "object"
        },
        "safety_class": {
          "default": "safe",
          "enum": [
            "safe",
            "confirm",
            "dangerous"
          ],
          "title": "Safety Class",
          "type": "string"
        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "required": [
        "name"
      ],
      "title": "VerbSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "const": 1,
      "default": 1,
      "description": "Manifest schema version.",
      "title": "Manifest",
      "type": "integer"
    },
    "id": {
      "description": "Slug, unique within a run or flock (e.g. arm-01).",
      "title": "Id",
      "type": "string"
    },
    "vendor": {
      "title": "Vendor",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "embodiment": {
      "enum": [
        "biped",
        "quadruped",
        "wheeled",
        "arm",
        "humanoid"
      ],
      "title": "Embodiment",
      "type": "string"
    },
    "mobility": {
      "enum": [
        "none",
        "legged",
        "wheeled"
      ],
      "title": "Mobility",
      "type": "string"
    },
    "intents": {
      "items": {
        "enum": [
          "twist",
          "skill",
          "gaze",
          "sound",
          "joint",
          "pose",
          "gripper"
        ],
        "type": "string"
      },
      "title": "Intents",
      "type": "array"
    },
    "sensors": {
      "items": {
        "enum": [
          "camera",
          "battery",
          "odometry",
          "imu",
          "tof",
          "microphone",
          "joint_state"
        ],
        "type": "string"
      },
      "title": "Sensors",
      "type": "array"
    },
    "verbs": {
      "items": {
        "$ref": "#/$defs/VerbSpec"
      },
      "title": "Verbs",
      "type": "array"
    },
    "preconditions": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Verb -> condition names. The adapter supplies the predicates by name.",
      "title": "Preconditions",
      "type": "object"
    },
    "safety_authority": {
      "$ref": "#/$defs/SafetyAuthority"
    },
    "frame": {
      "$ref": "#/$defs/Frame"
    },
    "limits": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Limits",
      "type": "object"
    },
    "backend": {
      "default": "",
      "description": "Which backend produced this (informational).",
      "title": "Backend",
      "type": "string"
    },
    "blurb": {
      "default": "",
      "description": "Prompt intro: 'a small biped duck robot ...'.",
      "title": "Blurb",
      "type": "string"
    },
    "extras": {
      "additionalProperties": true,
      "title": "Extras",
      "type": "object"
    }
  },
  "required": [
    "id",
    "vendor",
    "model",
    "embodiment",
    "mobility",
    "intents",
    "verbs"
  ],
  "title": "quackd robot manifest v1",
  "type": "object"
}
